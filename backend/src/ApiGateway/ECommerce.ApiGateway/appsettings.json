{
  "Jwt": {
    "Key": "ECommerceSecretKeyForJwtTokenGenerationMustBe256BitsLongAtLeast",
    "Issuer": "ECommerce.Identity",
    "Audience": "ECommerce.Client"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "products-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "cart-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "shipments-route": {
        "ClusterId": "shipping-cluster",
        "Match": {
          "Path": "/api/shipments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": { "Address": "http://identity-service:5001/" }
        }
      },
      "product-cluster": {
        "Destinations": {
          "product": { "Address": "http://product-service:5002/" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order": { "Address": "http://order-service:5003/" }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory": { "Address": "http://inventory-service:5004/" }
        }
      },
      "review-cluster": {
        "Destinations": {
          "review": { "Address": "http://review-service:5005/" }
        }
      },
      "shipping-cluster": {
        "Destinations": {
          "shipping": { "Address": "http://shipping-service:5006/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
